<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vantrix</title>
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #0b1020;
            color: white;
        }

        header {
            padding: 20px;
            background: #111936;
            border-bottom: 1px solid #29345c;
        }

        h1 {
            margin: 0;
            font-size: 28px;
        }

        .status {
            margin-top: 8px;
            color: #4ade80;
        }

        main {
            padding: 20px;
            max-width: 1000px;
            margin: auto;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 15px;
        }

        .card {
            background: #151d3b;
            padding: 20px;
            border-radius: 12px;
            border: 1px solid #29345c;
        }

        .value {
            font-size: 30px;
            font-weight: bold;
            margin-top: 10px;
        }

        button {
            margin-top: 20px;
            padding: 12px 20px;
            border: 0;
            border-radius: 8px;
            background: #2563eb;
            color: white;
            font-size: 16px;
        }
    </style>
</head>

<body>
    <header>
        <h1>Vantrix</h1>
        <div class="status">● System Online</div>
    </header>

    <main>
        <h2>Trading Dashboard</h2>

        <div class="grid">
            <div class="card">
                <div>System Status</div>
                <div class="value">ONLINE</div>
            </div>

            <div class="card">
                <div>Active Bots</div>
                <div class="value">0</div>
            </div>

            <div class="card">
                <div>Positions</div>
                <div class="value">0</div>
            </div>

            <div class="card">
                <div>Profit / Loss</div>
                <div class="value">$0.00</div>
            </div>
        </div>

        <button onclick="checkHealth()">Check Server</button>

        <p id="result"></p>
    </main>

    <script>
        async function checkHealth() {
            const result = document.getElementById("result");

            try {
                const response = await fetch("/health");
                const data = await response.json();

                result.textContent =
                    "Server: " + data.status;
            } catch (error) {
                result.textContent =
                    "Server connection failed.";
            }
        }
    </script>
</body>
